generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Exemplo {
    id        Int      @id @default(autoincrement())
    nome      String
    estado    Boolean  @default(true)
    preco     Decimal? @db.Decimal(10, 2)

    @@map("exemplo")
}

model Noticia {
    id             Int      @id @default(autoincrement())
    titulo         String
    resumo         String   @db.Text
    conteudo       String   @db.Text
    dataPublicacao DateTime
    urlImagem      String

    @@map("noticia")
}
